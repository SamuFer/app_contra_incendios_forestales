---
import DroneTelemetry from './DroneTelemetry.astro';
---

<aside class="w-full rounded-2xl border border-slate-800 bg-slate-950/80 p-5 shadow-xl shadow-black/20 backdrop-blur">
  <div class="space-y-5">
    <div>
      <label for="year" class="mb-2 block text-sm font-medium text-slate-300">Año</label>
      <select id="year" class="w-full rounded-xl border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100 outline-none ring-0 focus:border-orange-500">
        <option value="2024">2024</option>
        <option value="2025">2025</option>
        <option value="2026" selected>2026</option>
      </select>
    </div>

    <div>
      <label for="community" class="mb-2 block text-sm font-medium text-slate-300">Comunidad Autónoma</label>
      <select id="community" class="w-full rounded-xl border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100 outline-none ring-0 focus:border-orange-500">
        <option>Galicia</option>
        <option>Andalucía</option>
        <option selected>Castilla y León</option>
        <option>Madrid</option>
        <option>Valencia</option>
        <option>Cataluña</option>
      </select>
    </div>

    <div class="rounded-2xl border border-red-500/30 bg-gradient-to-br from-red-500/15 to-orange-500/10 p-4">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-slate-100">Predicción de Riesgo IA</h2>
        <span id="risk-badge" class="rounded-full bg-red-600/20 px-2.5 py-1 text-xs font-semibold text-red-400">Extremo</span>
      </div>
      <p id="risk-message" class="mt-3 text-sm text-slate-300">
        Olas de calor intensas elevan la probabilidad de propagación en las próximas 6 hours.
      </p>
      <div class="mt-4 h-2 rounded-full bg-slate-800">
        <div id="risk-bar" class="h-2 w-full rounded-full bg-gradient-to-r from-red-500 to-orange-400"></div>
      </div>
      <button id="predict-button" class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl border border-orange-500/30 bg-slate-900 px-3 py-2 text-sm font-medium text-orange-300 transition hover:bg-slate-800">
        <span id="risk-spinner" class="hidden h-4 w-4 animate-spin rounded-full border-2 border-orange-400 border-t-transparent"></span>
        <span>Calcular Predicción IA</span>
      </button>
    </div>

    <DroneTelemetry />
  </div>
</aside>

<script>
  // CORRECCIÓN 1: Forzamos el tipo exacto HTMLSelectElement para que reconozca '.value'
  const yearSelect = document.getElementById('year') as HTMLSelectElement | null;
  const predictButton = document.getElementById('predict-button');
  const riskMessage = document.getElementById('risk-message');
  const riskBadge = document.getElementById('risk-badge');
  const riskSpinner = document.getElementById('risk-spinner');
  const riskBar = document.getElementById('risk-bar');

  // CORRECCIÓN 2: Tipamos el objeto con un Record<string, ...> para permitir accesos dinámicos por clave
  const riskMessages: Record<string, { text: string; badge: string; width: string }> = {
    '2024': {
      text: 'Riesgo moderado en Galicia con vientos secos y baja humedad relativa.',
      badge: 'Alto',
      width: 'w-3/4',
    },
    '2025': {
      text: 'Riesgo alto en Andalucía por temperaturas extremas y baja visibilidad.',
      badge: 'Alto',
      width: 'w-5/6',
    },
    '2026': {
      text: 'Riesgo extremo en Castilla y León por ola de calor persistente.',
      badge: 'Extremo',
      width: 'w-full',
    },
  };

  yearSelect?.addEventListener('change', (event) => {
    // CORRECCIÓN 3: Le indicamos a TypeScript que el origen del evento es un input/select de HTML
    const target = event.target as HTMLSelectElement;
    const selectedYear = target.value;
    window.dispatchEvent(new CustomEvent('year-change', { detail: { year: selectedYear } }));
  });

  predictButton?.addEventListener('click', () => {
    const selectedYear = yearSelect?.value || '2026';
    const nextRisk = riskMessages[selectedYear] || riskMessages['2026'];

    riskSpinner?.classList.remove('hidden');
    predictButton.setAttribute('disabled', 'true');

    setTimeout(() => {
      if (riskMessage) riskMessage.textContent = nextRisk.text;
      if (riskBadge) {
        riskBadge.textContent = nextRisk.badge;
        riskBadge.className = nextRisk.badge === 'Extremo'
          ? 'rounded-full bg-red-600/20 px-2.5 py-1 text-xs font-semibold text-red-400'
          : 'rounded-full bg-orange-500/20 px-2.5 py-1 text-xs font-semibold text-orange-400';
      }
      if (riskBar) {
        riskBar.className = `h-2 rounded-full bg-gradient-to-r from-red-500 to-orange-400 ${nextRisk.width}`;
      }
      riskSpinner?.classList.add('hidden');
      predictButton.removeAttribute('disabled');
    }, 1000);
  });
</script>
